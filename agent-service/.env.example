# ── PocketBase (superusuario admin, el mismo con el que entrás al panel /_/) ──
PB_URL=https://pocketbase-d4iq.srv1851703.hstgr.cloud
PB_ADMIN_EMAIL=fernandomateo23@gmail.com
PB_ADMIN_PASSWORD=

# ── Telegram ──
# 1) Hablale a @BotFather en Telegram, /newbot, elegí nombre y usuario, pegá el token acá.
TELEGRAM_BOT_TOKEN=
# 2) Hablale a @userinfobot para ver tu chat_id numérico. SOLO esos chats pueden usar el agente.
#    Podés poner varios separados por coma (por ejemplo si sumás a alguien del equipo).
TELEGRAM_ALLOWED_CHAT_IDS=

# ── Email (Gmail con contraseña de aplicación, NO tu contraseña normal) ──
# Generarla en: https://myaccount.google.com/apppasswords (requiere verificación en 2 pasos activada)
GMAIL_USER=fernandomateo23@gmail.com
GMAIL_APP_PASSWORD=
ALERT_EMAIL_TO=fernandomateo23@gmail.com

# ── Modo lenguaje natural (opcional) ──
# Completá UNA de estas para poder escribirle en texto libre además de los comandos /.
# Sin ninguna, el bot funciona igual pero solo con comandos /.
# Orden de preferencia si completás más de una: Anthropic > Groq > Gemini.
ANTHROPIC_API_KEY=
# Recomendado si no querés pagar: gratis, sin tarjeta. Conseguí la key en https://console.groq.com/keys
GROQ_API_KEY=
# Gemini: hoy (sept. 2026) tiene un bug de Google con las claves nuevas "AQ." — evitalo por ahora.
GEMINI_API_KEY=

# ── Horarios de tareas automáticas (formato cron, zona horaria de abajo) ──
DAILY_SUMMARY_CRON=0 8 * * 1-5
WEEKLY_SUMMARY_CRON=0 8 * * 1
OVERDUE_CHECK_CRON=0 9,15 * * *
TZ=America/Argentina/Cordoba

# ── Notificaciones al teléfono (reenvío por Telegram de los avisos del dashboard) ──
# Cada cuánto revisa si hay notificaciones nuevas para reenviar (ms). 20000 = cada 20s.
NOTIFY_PHONE_POLL_MS=20000

# ── Generador de propuestas con IA ──
# Cada cuánto revisa si hay propuestas pendientes de generar (ms). 15000 = cada 15s.
PROPOSAL_POLL_MS=15000
# URL pública del dashboard, para armar el link que se manda por Telegram cuando una
# propuesta queda lista.
DASHBOARD_URL=https://mateoestudio.cloud

# ── Renzo — clientes inactivos ──
# Días sin actividad (sin proyecto activo ni factura) para considerar a un cliente "inactivo".
RENZO_INACTIVE_DAYS=45
RENZO_CRON=0 9 * * 1-5

# ── Facundo — recordatorio preventivo de facturas ──
# Avisa las facturas "enviadas" que vencen dentro de esta cantidad de días (antes de que venzan).
FACUNDO_DUE_SOON_DAYS=3
FACUNDO_CRON=5 9 * * 1-5

# ── Bruno — tareas estancadas del Kanban ──
# Días sin cambiar de estado para considerar una tarea "estancada".
BRUNO_STALLED_DAYS=5
BRUNO_CRON=10 9 * * 1-5

# ── Nahuel — prospección de clientes en Google Maps ──
# Necesita un proyecto en Google Cloud Console con facturación activa (tarjeta cargada — Google
# da uso gratis mensual, pero hay que habilitarla igual) y la "Places API" habilitada. La key se
# genera en "Credenciales" dentro de ese proyecto.
GOOGLE_MAPS_API_KEY=
# Ciudades y rubros a rotar en cada búsqueda (separados por coma). Ajustalos a lo que te sirva.
NAHUEL_CITIES=Miami,Ciudad de México,Ciudad de Panamá
NAHUEL_CATEGORIES=restaurantes,clínicas dentales,estudios de abogados,inmobiliarias,gimnasios,spas y centros de estética,hoteles boutique,concesionarias de autos
# Cuántos resultados nuevos procesa como máximo por corrida (cada uno gasta cuota de la API).
NAHUEL_MAX_RESULTS=10
NAHUEL_CRON=0 10 * * 1
